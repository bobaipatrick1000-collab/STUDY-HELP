# Copy this file to .env.local and fill in your real values.
# .env.local is never committed and never sent to the browser.

# Provider: "openrouter" or "google". If unset, defaults to openrouter when its
# API key is present, otherwise google.
AI_PROVIDER=openrouter

# Your OpenRouter API key (get one at https://openrouter.ai/keys). Paste your key here.
OPENROUTER_API_KEY=

# The model to use on the active provider. Change this value here anytime — no code
# changes needed.
# - OpenRouter (AI_PROVIDER=openrouter): any id from https://openrouter.ai/models,
#   e.g. openai/gpt-4o-mini, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct.
# - Google (AI_PROVIDER=google): gemini-3.5-flash-lite (largest free allowance) or
#   gemini-3.5-flash.
AI_MODEL=openai/gpt-4o-mini

# Web search (Tavily) — grounds generated content in real, verified web sources.
# Get a key at https://app.tavily.com (free: 1,000 credits/month). If left empty,
# Tavily keyless access is used (works, lower rate limits).
SEARCH_API_KEY=
# Web search backup (Brave Search) — used only when Tavily fails (out of credits/quota,
# rejected key, network error, or empty results). Leave empty to disable the fallback.
# Get a key at https://brave.com/search/api/ (free tier available).
BRAVE_API_KEY=your_key_here
# Number of web results to fetch per search, max chars kept per result / in total.
SEARCH_NUM_RESULTS=8
SEARCH_MAX_RESULT_CHARS=4000
SEARCH_BUDGET_CHARS=24000
# How many hours to reuse cached search results for the same topic (default 168 = 7 days).
SEARCH_CACHE_TTL_HOURS=168
# Optional test override for the search provider: "auto" (default, Tavily then Brave),
# "tavily" (Tavily only, never falls back), or "brave" (force Brave, to test the fallback).
# SEARCH_PROVIDER=auto

# Optional: Google AI Studio key, used only when AI_PROVIDER=google (enables live web
# search source links in "Search a topic"). Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=